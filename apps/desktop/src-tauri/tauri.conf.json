{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jeanne",
  "version": "0.1.0",
  "identifier": "org.jeanneproject.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Jeanne",
        "label": "main",
        "width": 1024,
        "height": 720,
        "resizable": true,
        "fullscreen": false
      },
      {
        "title": "Jeanne Quick Access",
        "label": "quick-access",
        "width": 720,
        "height": 64,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
