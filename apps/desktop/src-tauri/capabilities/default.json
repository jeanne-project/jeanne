{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for Jeanne windows",
  "windows": ["main", "quick-access"],
  "permissions": [
    "core:default",
    "core:window:allow-set-size",
    "core:window:allow-hide",
    "allow-search-notes",
    "allow-capture-quick-note",
    "allow-open-note-in-editor",
    "allow-get-vault-stats",
    "allow-get-core-version",
    "allow-set-quick-access-height",
    "allow-exit-app",
    "allow-load-local-model",
    "allow-unload-local-model",
    "allow-get-hardware-profile",
    "allow-get-local-inference-stats",
    "allow-get-default-model-path",
    "allow-execute-todo",
    "allow-get-vault-tasks",
    "allow-toggle-vault-task",
    "allow-execute-log",
    "allow-execute-meeting",
    "allow-execute-bookmark",
    "allow-get-snippets",
    "allow-evaluate-math",
    "allow-ai-process-clipboard",
    "allow-ask-vault",
    "allow-list-available-models",
    "allow-get-models-directory",
    "allow-get-local-engine-config",
    "allow-update-local-engine-config",
    "allow-toggle-voice-pipeline",
    "allow-get-voice-status",
    "allow-list-audio-devices",
    "allow-transcribe-pcm-chunk",
    "allow-synthesize-text-to-audio",
    "allow-start-meeting-recording",
    "allow-stop-meeting-recording",
    "allow-get-meeting-recording-status",
    "allow-list-meeting-sessions",
    "allow-seek-meeting-audio"
  ]
}

