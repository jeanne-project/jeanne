{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for Jeanne windows",
  "windows": ["main", "quick-access"],
  "permissions": [
    "core:default",
    "core:window:allow-set-size",
    "core:window:allow-hide",
    "shell:default",
    "global-shortcut:default",
    "allow-search-notes",
    "allow-capture-quick-note",
    "allow-open-note-in-editor",
    "allow-get-vault-stats",
    "allow-get-core-version",
    "allow-set-quick-access-height"
  ]
}
